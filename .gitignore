# OS
.DS_Store

# Node dependencies (the back-office)
node_modules/

# Secrets — local environment
.env

# Local drop folder for masters before they're added in the back-office: the
# folder, not its contents.
album-staging/*
!album-staging/.gitkeep

# Source album archive: keep the folder, not its contents (heavy media,
# kept locally but never pushed to the remote).
album-archive/*
!album-archive/.gitkeep

# Album and series media: served from cdn.trognon.space (tools/media-sync.sh),
# not the repo. The local copy under site/assets/{album,series}/ is the source.
site/assets/album/
site/assets/series/

# Editor / agent tooling: local, machine-specific config, not portable.
.vscode/
.claude/

# Wrangler local state (wrangler dev / deploy)
.wrangler/
